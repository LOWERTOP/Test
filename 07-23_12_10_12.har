+Wf3K/gs+5mx9RILXNMDQ=="}],"queryString":[],"postData":{"mimeType":"application/json","text":"{\"state\":1,\"columned\":0,\"pageSize\":10,\"pageIndex\":1}"},"headersSize":-1,"bodySize":52},"cache":{},"timings":{"send":0,"wait":222,"receive":0},"serverIPAddress":"111.13.40.27","response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Server","value":"openresty"},{"name":"Date","value":"Thu, 23 Jul 2026 04:10:24 GMT"},{"name":"Content-Type","value":"application/json"},{"name":"Connection","value":"keep-alive"},{"name":"vary","value":"Origin"},{"name":"trace-id","value":"ff1187d4a3a4e43cc420af4a43015411"},{"name":"x-envoy-upstream-service-time","value":"186"},{"name":"Access-Control-Allow-Methods","value":"GET,POST,OPTIONS,HEAD,PUT"},{"name":"Access-Control-Allow-Headers","value":"Content-type,Authorization,Keep-Alive,User-Agent,Cache-Control,Userid,Token"},{"name":"Access-Control-Max-Age","value":"600"},{"name":"Content-Encoding","value":"gzip"},{"name":"Content-Length","value":"5537"}],"content":{"size":16658,"mimeType":"application/json","text":"{\"code\":0,\"msg\":\"处理成功\",\"time\":1784779824943,\"data\":{\"records\":[{\"id\":\"1739484789623414786\",\"label\":1,\"title\":\"圣诞\\uD83C\\uDF84额外耗材名单公示~\",\"thumbnail\":\"先感谢\\uD83D\\uDE4F\\uD83C\\uDFFB大家的积极参与！\\n圣诞期间收到不少大家分享上传的模型，以及打印分享的内容。 \\n完成任务联系客服的朋友们，奖品基本都已经发出。 \\n\\n话不多说，我们这个帖就直接公示额外耗材获得的朋友。\\n\\n这次我们评选了三名用户：\\nTiAmo   \\n居于数年 \\n时宇\\n\\n他们无论是模型上色还是打印过程分享，都非常用心。\\n这三名用户都将额外获得一盒官方耗材赠送，大家凭个人主页截图＋作品图，联系客服即可领取哦～ \\n我们下次活动再见\\uD83D\\uDC4B\\uD83C\\uDFFB\",\"type\":\"321654\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"10\",\"createdTime\":1703560467000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":22,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1703559682700/f5738.jpg\"},{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1703559682700/2720.jpg\"},{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1703559682700/af244.jpg\"}],\"picNum\":3},{\"id\":\"1736615359427031041\",\"label\":1,\"title\":\"创意点燃，圣诞3D打印狂欢！\",\"thumbnail\":\"亲爱的米家3D打印社区成员们，圣诞节来临，我们为您准备了一场创意无限的3D打印盛宴！只需参与活动，您将有机会赢取丰富耗材奖励！\\n\\n活动时间：12月16日-12月25日。\\n\\n参与方式及要求：\\n圣诞主题模型分享：上传您的原创或最喜欢的圣诞模型，让创意飞扬！\\n\\n打印挑战赛：完成圣诞主题模型的打印挑战，展示您的技术和创造力。\\n\\n获奖要求：\\n1.活动开始日起，上传1个圣诞主题模型被其他用户打印2次及以上（模型要求不侵权，不涉及其他违规要素，可被打印）；\\n2\",\"type\":\"123456\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"15\",\"createdTime\":1702876341000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":31,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1702883634512/5f114.jpg\"}],\"picNum\":1},{\"id\":\"1731497137896873986\",\"label\":1,\"title\":\"米家3D打印“创意美好生活”\",\"thumbnail\":\"3D打印能打印出哪些有创意又实用的模型？\\n利用3D打印机\\n制作一些小物件\\n既新奇又带来便利\\n而对于积极生活，带来美好的你\\n我们绝不辜负！\\n“创意美好生活”惊喜活动送耗材，来了来了~\\n\\n活动时间：12月4日-12月24日，限量前100名。\\n\\n参与方式及要求：\\n活动开始日起，打印3个模型（需打印3次），发帖分享成品和打印心得即可免费获得米家3D打印耗材2盒。\\n模型类别不做限制，尺寸5cm起，需拆支撑打磨处理。\\n成品有创意又实用的，我们将给予额外的耗材奖励~\",\"type\":\"321654\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"18\",\"createdTime\":1701656062000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":16,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1701742353821/e8160.jpg\"}],\"picNum\":1},{\"id\":\"1721395230710923266\",\"label\":1,\"title\":\"万圣节特别活动获奖名单！\",\"thumbnail\":\"首届万圣节活动我们就告一段落啦~\\n感谢大家的热情参与！\\n下面就公示这次活动的获奖选手：\\n“万圣节模型王”第一名——凤梨罐头（#万圣节活动#加灯上色南瓜王八）\\n上色很有创意，拍照也很用心，效果非常好。  \\n获得3盒官方耗材\\n\\n“万圣节模型王”第二名——新手1696924643445210（#万圣节活动#相信自己，哦哦哦哦）\\n这位朋友不仅打印上色，还自己配上了蜡烛，很有氛围感。\\n获得2盒官方耗材\\n\\n“万圣节模型王”第三名——糖蒜（＃万圣节活动＃可可爱爱只有脑袋的南\",\"type\":\"369852\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"14\",\"createdTime\":1699247580000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":22,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1699247497717/b9676.png\"},{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1699247497717/90400.png\"}],\"picNum\":2},{\"id\":\"1719303332378779650\",\"label\":1,\"title\":\"“小红书”创作精美作品送福利！\",\"thumbnail\":\"最棒的手办是来自于自己的亲手创作。\\n参与小米3D打印机作品创作分享活动，用独特的作品赢取丰厚的礼品。\\n一起开启3D打印机创造之旅。\\n\\n活动时间：11.1-11.15 （两周时间）\\n参与对象：每一个购买小米3D打印机的用户\\n\\n参与方式：\\n拍照或录制短视频，分享你的精美作品和打印心得即可获得免费米家3D打印耗材一盒。\\n可以是模型库模型，也可以是自己创作模型，模型需打磨处理。\\n分享到小红书平台，并加上标签，#小米3D打印机 #米家3D打印机 以及其他3D相\",\"type\":\"321654\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"17\",\"createdTime\":1698748832000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":18,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1698829271761/f518.png\"}],\"picNum\":1},{\"id\":\"1699692240614559746\",\"label\":1,\"title\":\"这是一个发布模型的科普贴！\",\"thumbnail\":\"  目前大家对于发布模型有一些疑问，针对这个问题，我们将进行一个解答。\\n  当前发布模型有两种，一种是原创模型，一种为分享模型。\\n  原创模型用户可自行选择定价以及协议类型，而分享模型无法定价，且需要根据原作者的协议要求分享。\\n\\n注意：无论是原创模型还是分享模型，都不建议您发布IP模型，这将可能涉及版权侵权。（类似原神这种全球范围开放同人版权可给大家创作的除外，当然涉及商用也有数量等条件的限制，大家感兴趣原神，后面小编可以研究出一个帖） \\n\\n分界线 \\n————————————————————————\\n\\n\\n以下的正经严肃的科普\\n一、释义：CC协议是部分原创者为了创意共享，主动放弃被法律保护的部分或全部版权，在公布作品时选择的协议。\\n\\n二、目的：为了在作者保留相关版权权利的前提下，作品在满足特定条件的情况下便可以被自由复制、传播，在不违反版权保护法律的情况下获得或分享更多创作素材。\\n\\n三、注：CC协议原作者放弃的是版权，并不是著作权，即使是使用CC0作品也不能冒用原作者名义。（以下权益皆以不可冒用原作者名义为前提）\\n\\n四、标识与具体权益：  \",\"type\":\"321654\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"19\",\"createdTime\":1694073184000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":14,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1694073484213650.png\"}],\"picNum\":1},{\"id\":\"1698578606232539137\",\"label\":1,\"title\":\"解决各种疑问的官方答疑（新手说明书）\",\"thumbnail\":\"  我们为第一次使用光固化打印机的您，准备了充足的教程。您可在“APP-我的-打印教程”找到它。\\n  除此之外，您也可在下方评论区留下您的问题或使用微信搜索公众号“胜马优创”联系在线客服，官方客服会尽量在第一时间解答。\\n\\n问答精选\\n（便于您查看，我们将以表格形式更新）\",\"type\":\"369852\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"12\",\"createdTime\":1693807672000,\"authorInfo\":{\"id\":\"1697518095516667905\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1697518095516667905/813W14F13P12.png\",\"userNickname\":\"米家3D打印官方号\",\"userLevel\":2,\"identityType\":3,\"reminded\":false},\"commentReplyNum\":127,\"attachmentVos\":[{\"picUrl\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/post/1697518095516667905/1694420916023634.png\"}],\"picNum\":1},{\"id\":\"1676465262927872002\",\"label\":1,\"title\":\"超有用的6个3D打印模型网站整理来啦！\",\"thumbnail\":\"并非每个人都有时间或技能将概念转化为模型，如果你只是想要找一些有趣的东西来打印，这篇帖子我将为大家整理了6个3D打印模型网站。通过这些，你可以了解世界各地的创客们都在玩什么，也可以找到自己喜欢的模型。\\n1.Thingiverse\\n网址:https://www.thingiverse.com/\\n世界上最大的3D打印社区，有超250万个模型，最大的优势是任何人都可以免费下载，无需注册，当然也因为模型数量庞大，又是免费，有些模型质量不够好，需要自己筛选。\",\"type\":\"321654\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"163\",\"createdTime\":1688535441000,\"authorInfo\":{\"id\":\"1627494779481346050\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1627494779481346050/T0B10W3T1.jpg\",\"userNickname\":\"不讲李\",\"userLevel\":3,\"identityType\":2,\"reminded\":false,\"medalVos\":[{\"medalId\":\"1539509191976108033\",\"name\":\"顶尖创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":6330,\"loginDay\":300,\"shareRatio\":80,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/10.png\",\"obtain\":null,\"level\":10},{\"medalId\":\"1539509191997079554\",\"name\":\"名匠创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":4760,\"loginDay\":230,\"shareRatio\":80,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/9.png\",\"obtain\":null,\"level\":9},{\"medalId\":\"1539509191997079555\",\"name\":\"大师创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":3470,\"loginDay\":180,\"shareRatio\":70,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/8.png\",\"obtain\":null,\"level\":8},{\"medalId\":\"1539509191997079556\",\"name\":\"达人创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":2520,\"loginDay\":150,\"shareRatio\":70,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/7.png\",\"obtain\":null,\"level\":7},{\"medalId\":\"1539509191997079557\",\"name\":\"专业创客\",\"