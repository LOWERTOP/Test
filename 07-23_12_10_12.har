凹凸不平。\\n大家有没有什么技巧分享？\",\"type\":\"123456\",\"state\":1,\"currentUserIsLiked\":false,\"curLikeNum\":0,\"likeNum\":\"19\",\"createdTime\":1682580579000,\"authorInfo\":{\"id\":\"1627494779481346050\",\"userAvatar\":\"https://cnbj1-new.fds.api.xiaomi.com/shengma-3d-printing-public/avatar/1627494779481346050/T0B10W3T1.jpg\",\"userNickname\":\"不讲李\",\"userLevel\":3,\"identityType\":2,\"reminded\":false,\"medalVos\":[{\"medalId\":\"1539509191976108033\",\"name\":\"顶尖创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":6330,\"loginDay\":300,\"shareRatio\":80,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/10.png\",\"obtain\":null,\"level\":10},{\"medalId\":\"1539509191997079554\",\"name\":\"名匠创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":4760,\"loginDay\":230,\"shareRatio\":80,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/9.png\",\"obtain\":null,\"level\":9},{\"medalId\":\"1539509191997079555\",\"name\":\"大师创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":3470,\"loginDay\":180,\"shareRatio\":70,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/8.png\",\"obtain\":null,\"level\":8},{\"medalId\":\"1539509191997079556\",\"name\":\"达人创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":2520,\"loginDay\":150,\"shareRatio\":70,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/7.png\",\"obtain\":null,\"level\":7},{\"medalId\":\"1539509191997079557\",\"name\":\"专业创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":1735,\"loginDay\":125,\"shareRatio\":60,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/6.png\",\"obtain\":null,\"level\":6},{\"medalId\":\"1539509191997079558\",\"name\":\"中级创客\",\"describe\":\"累计经验值达到{0}，并登录{1}天\",\"experience\":1120,\"loginDay\":95,\"shareRatio\":60,\"icon\":\"https://cnbj1.fds.api.xiaomi.com/shengma-3d-printing-public/medal/5.png\",\"obtain\":null,\"level\":5},{\"medalId\":\"1539509192